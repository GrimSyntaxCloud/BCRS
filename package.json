{
  "name": "bcrs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node --watch --env-file-if-exists=.env api/local.js",
    "dev": "ng build && node --env-file-if-exists=.env api/local.js",
    "render-deploy": "ng build --configuration=production",
    "test:api": "npm --prefix api test",
    "package:azure": "node scripts/package-azure.mjs",
    "preview": "node api/test/preview.cjs",
    "test:ui": "ng test --watch=false"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "chart.js": "^4.2.1",
    "ngx-cookie-service": "22.0.0",
    "primeicons": "7.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "typescript": "6.0.3",
    "@angular/build": "22.2.4",
    "vitest": "^4.0.8",
    "jsdom": "^27.0.0"
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.32.1"
    },
    "vite": "8.3.5"
  }
}
