{
  "name": "bcrs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node --watch --env-file-if-exists=.env api/local.js",
    "dev": "ng build && node --env-file-if-exists=.env api/local.js",
    "render-deploy": "ng build --configuration=production",
    "test:api": "npm --prefix api test",
    "package:azure": "node scripts/package-azure.mjs",
    "preview": "node api/test/preview.cjs",
    "test:ui": "ng test --watch=false"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "chart.js": "^4.2.1",
    "ngx-cookie-service": "21.3.1",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0",
    "@primeuix/themes": "2.0.3"
  },
  "devDependencies": {
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "typescript": "5.9.3",
    "@angular/build": "21.2.27",
    "vitest": "^4.0.8",
    "jsdom": "^27.0.0"
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.32.1"
    },
    "vite": "7.3.7"
  }
}
